# Postgres connection string (Neon). Leave empty to use the in-memory store for local play.
# A Vercel production deployment refuses to start without it.
DATABASE_URL=
# Long random string used to sign login cookies. Required in production.
SESSION_SECRET=
# Set to "true" to show the "Test pilot" button on a deployed preview. Always off in Vercel production.
ENABLE_DEV_LOGIN=false
# Test pilots idle for this many days are deleted (with their claims and factory). Default 7.
TEST_PILOT_RETENTION_DAYS=7
